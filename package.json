{
  "name": "apextrader",
  "description": "Blazing fast professional trading interface",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run build:storybook",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build --output-dir dist/storybook",
    "preview": "vite preview",
    "start": "serve dist -l ${PORT:-3000} -c ../serve.json",
    "data:tardis": "node scripts/tardis-ingest-v2.mjs",
    "data:tardis:download": "node scripts/tardis-ingest-v2.mjs --download",
    "data:tardis:liquidity": "node scripts/tardis-liquidity-tiles.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:coverage": "TMPDIR=/tmp node --test --experimental-test-coverage --test-coverage-include='src/services/**/*.js' --test-coverage-include='src/hooks/**/*.js' --test-coverage-include='src/components/professional/chart/marketChartPresentation.js' tests/*.test.js",
    "test:coverage:chart": "TMPDIR=/tmp node --test --experimental-test-coverage --test-coverage-include='src/components/professional/chart/marketChartPresentation.js' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/marketChartPresentation.test.js",
    "test:coverage:replay": "TMPDIR=/tmp node --test --experimental-test-coverage --test-coverage-include='src/services/replay/professionalView.js' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/professionalView.test.js",
    "test:e2e": "playwright test",
    "test:visual": "TMPDIR=/tmp playwright test -c playwright.visual.config.js",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs --ignore-path .gitignore",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"tests/**/*.js\" .eslintrc.cjs index.html playwright.config.js vite.config.js package.json"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rushstack/eslint-patch": "^1.3.2",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.43.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "2.8.8",
    "storybook": "8.6.14",
    "vite": "^4.3.5"
  }
}
