{
  "name": "apextrader",
  "description": "Blazing fast professional trading interface",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "data:bybit": "node scripts/bybit-ingest.mjs",
    "data:bybit:download": "node scripts/bybit-ingest.mjs --download",
    "data:bybit:inspect": "node scripts/bybit-inspect.mjs",
    "data:upload": "node scripts/market-data-upload.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs --ignore-path .gitignore",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"tests/**/*.js\" .eslintrc.cjs index.html playwright.config.js vite.config.js package.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@vitejs/plugin-react": "^4.3.4",
    "chart.js": "^4.3.0",
    "cryptocurrency-icons": "^0.18.1",
    "highcharts": "^11.1.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.33.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rushstack/eslint-patch": "^1.3.2",
    "eslint": "^8.43.0",
    "eslint-plugin-react": "^7.37.5",
    "path": "^0.12.7",
    "prettier": "2.8.8",
    "vite": "^4.3.5"
  }
}
