{
  "name": "apextrader",
  "description": "Blazing fast professional trading interface",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l ${PORT:-3000} -c ../serve.json",
    "data:tardis": "node scripts/tardis-ingest-v2.mjs",
    "data:tardis:download": "node scripts/tardis-ingest-v2.mjs --download",
    "data:tardis:liquidity": "node scripts/tardis-liquidity-tiles.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs --ignore-path .gitignore",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"tests/**/*.js\" .eslintrc.cjs index.html playwright.config.js vite.config.js package.json"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rushstack/eslint-patch": "^1.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.43.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "2.8.8",
    "vite": "^4.3.5"
  }
}
