{
  "name": "apextrader",
  "description": "Blazing fast professional trading interface",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": "22.x"
  },
  "docs": "vitepress",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "serve dist -l ${PORT:-3000}",
    "data:tardis": "node scripts/tardis-ingest.mjs",
    "data:tardis:download": "node scripts/tardis-ingest.mjs --download",
    "test:unit": "node --experimental-default-type=module --test tests/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs --ignore-path .gitignore",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"tests/**/*.js\" .eslintrc.cjs index.html playwright.config.js vite.config.js package.json",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "chart.js": "^4.3.0",
    "cryptocurrency-icons": "^0.18.1",
    "highcharts": "^11.1.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.35.1",
    "@rushstack/eslint-patch": "^1.3.2",
    "eslint": "^8.43.0",
    "eslint-plugin-react": "^7.37.5",
    "path": "^0.12.7",
    "prettier": "2.8.8",
    "vite": "^4.3.5"
  }
}
